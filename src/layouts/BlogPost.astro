---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

// Import React components
// import CommentForm from '../components/CommentForm.jsx'; // Already imported
// import CommentList from '../components/CommentList.jsx'; // Already imported
import HeatmapDisplay from '../components/HeatmapDisplay.jsx'; // New import

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* ... existing styles ... */
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
            .comments-section {
                margin-top: 40px;
                padding-top: 20px;
                border-top: 1px solid #eee;
            }
            /* Style for the container of HeatmapDisplay if needed */
            .heatmap-container {
                margin-top: 30px;
            }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot /> {/* Blog post content renders here */}

                    <div id="comments-app" class="comments-section">
                        {/* Comments rendered by script */}
                    </div>

                    {/* Heatmap Display - Needs client directive for React component */}
                    <div class="heatmap-container">
                        <HeatmapDisplay client:visible />
                    </div>
				</div>
			</article>
		</main>
		<Footer />

        <script type="module">
            import React from 'react';
            import ReactDOM from 'react-dom/client';
            import CommentForm from '../components/CommentForm.jsx';
            import CommentList from '../components/CommentList.jsx';
            // HeatmapDisplay is now rendered via Astro directive, so no need to import here for ReactDOM.render

            const CommentsApp = () => {
                const [comments, setComments] = React.useState([
                    { id: 1, author: 'Alice', text: 'Great post!', ipAddress: '192.168.0.1 (Mock)', timestamp: new Date(Date.now() - 100000).toISOString() },
                    { id: 2, author: 'Bob', text: 'Thanks for sharing.', ipAddress: '203.0.113.42 (Mock)', timestamp: new Date().toISOString() }
                ]);

                const handleCommentSubmit = (newComment) => {
                    setComments(prevComments => [newComment, ...prevComments]);
                };

                return (
                    <>
                        <CommentList comments={comments} />
                        <CommentForm onCommentSubmit={handleCommentSubmit} />
                    </>
                );
            };

            const container = document.getElementById('comments-app');
            if (container) {
                const root = ReactDOM.createRoot(container);
                root.render(<CommentsApp />);
            }
        </script>
	</body>
</html>
